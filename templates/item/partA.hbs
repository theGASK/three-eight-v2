<section class="t8-partA">
  <div class="t8-identity">
    <img class="t8-portrait" src="{{item.img}}" data-edit="img" data-action="editImage" alt="{{item.name}}" />
    <div class="t8-identity-text">
      <input class="t8-name" type="text" name="name" value="{{item.name}}" {{#unless isEditable}}disabled{{/unless}} />
      <span class="t8-type-badge">{{typeLabel}}</span>
    </div>
  </div>
  {{#if (eq item.type "skill")}}
  <div class="t8-vitals">
    <div class="t8-vital t8-vital-compact">
      <span class="t8-vital-label">Group</span>
      <span class="t8-vital-static">{{skillGroupLabel}}</span>
    </div>
    <div class="t8-vital t8-vital-compact">
      <span class="t8-vital-label">Skill Value</span>
      <span class="t8-vital-static">{{skillValue}}</span>
    </div>
  </div>
  {{else if (eq item.type "specialty")}}
  <div class="t8-vitals" style="flex-grow: 1; padding-left: 2rem;">
    <div class="t8-vital t8-vital-compact">
      <span class="t8-vital-label">Linked Skill</span>
      <span class="t8-vital-static">{{linkedSkillName}}</span>
    </div>
    <div class="t8-vital" style="flex-direction: row; align-items: center; gap: 1rem; flex-grow: 1;">
      <span class="t8-vital-label">Score</span>
      <input type="range" name="system.score" min="-1" max="5" step="1" value="{{system.score}}"
        style="flex-grow: 1;" />
      <span class="t8-vital-static" style="width: 2rem; text-align: right;">{{system.score}}</span>
    </div>
  </div>
  {{else}}
  <div class="t8-vitals">
    <div class="t8-vital t8-vital-compact">
      <span class="t8-vital-label">{{localize "THREEEIGHT.Item.Cost"}}</span>
      <input type="number" name="system.cost" value="{{system.cost}}" min="0" step="1" {{#unless
        isEditable}}disabled{{/unless}} />
    </div>
    <div class="t8-vital t8-vital-compact">
      <span class="t8-vital-label">{{localize "THREEEIGHT.GeneralObject.Encumbrance"}}</span>
      <input type="number" name="system.encumbrance" value="{{system.encumbrance}}" min="0" step="0.1" {{#unless
        isEditable}}disabled{{/unless}} />
    </div>
    <div class="t8-vital t8-vital-compact">
      <span class="t8-vital-label">{{localize "THREEEIGHT.Item.Legal"}}</span>
      <input type="checkbox" name="system.legal" {{#if system.legal}}checked{{/if}} {{#unless
        isEditable}}disabled{{/unless}} />
    </div>
    <div class="t8-vital t8-vital-compact">
      <span class="t8-vital-label">{{localize "THREEEIGHT.Item.Equipped"}}</span>
      <input type="checkbox" name="system.equipped" {{#if system.equipped}}checked{{/if}} {{#unless
        isEditable}}disabled{{/unless}} />
    </div>
  </div>
</section>
{{/if}}
</section>