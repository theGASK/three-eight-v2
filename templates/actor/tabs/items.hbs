<div class="t8-tab-content">
  {{#each itemsByType as |items type|}}
  <h3 class="t8-section-title">
    {{localize (concat "TYPES.Item." type)}}
    <span class="t8-count">{{items.length}}</span>
  </h3>
  <ul class="t8-item-list">
    {{#each items as |item|}}
    <li class="t8-item-row" data-item-id="{{item.id}}">
      <img class="t8-item-icon" src="{{item.img}}" alt="{{item.name}}" />
      <span class="t8-item-name" data-action="editItem" data-item-id="{{item.id}}">{{item.name}}</span>
      <button type="button" data-action="deleteItem" data-item-id="{{item.id}}">
        <i class="fas fa-trash"></i>
      </button>
    </li>
    {{/each}}
  </ul>
  {{/each}}

  {{#unless itemsByType}}
  <p class="t8-empty">{{localize "THREEEIGHT.Sheet.NoItems"}}</p>
  {{/unless}}
</div>