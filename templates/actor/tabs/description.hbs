<div class="t8-tab-content">
  <div class="t8-description">
    {{#if isEditable}}
      {{#if enrichedDescription}}
        <div class="t8-prose">{{{enrichedDescription}}}</div>
      {{else}}
        <p class="t8-empty">{{localize "THREEEIGHT.Sheet.NoDescription"}}</p>
      {{/if}}
      <prose-mirror name="system.description" value="{{system.description}}"
                    {{#unless isEditable}}disabled{{/unless}}></prose-mirror>
    {{else}}
      <div class="t8-prose">{{{enrichedDescription}}}</div>
    {{/if}}
  </div>
</div>