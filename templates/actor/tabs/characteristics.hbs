<div class="t8-tab-content">
  {{#if primaryKeys.length}}
  <h3 class="t8-section-title">{{localize "THREEEIGHT.Sheet.Primary"}}</h3>
  <div class="t8-stat-grid">
    {{#each primaryKeys as |key|}}
    <div class="t8-stat">
      <label class="t8-stat-label">
        {{localize (concat "THREEEIGHT.Actor.Primary." (capitalize key))}}
      </label>
      <input class="t8-stat-input" type="number"
             name="system.attributes.primary.{{key}}"
             value="{{lookup ../system.attributes.primary key}}"
             {{#unless ../isEditable}}disabled{{/unless}} />
      <span class="t8-stat-dm">
        {{lookup ../system.attributes.primary (concat key "DM")}}
      </span>
    </div>
    {{/each}}
  </div>
  {{/if}}

  {{#if secondaryKeys.length}}
  <h3 class="t8-section-title">{{localize "THREEEIGHT.Sheet.Secondary"}}</h3>
  <div class="t8-stat-grid">
    {{#each secondaryKeys as |key|}}
    <div class="t8-stat">
      <label class="t8-stat-label">
        {{localize (concat "THREEEIGHT.Actor.Secondary." (capitalize key))}}
      </label>
      <input class="t8-stat-input" type="number"
             name="system.attributes.secondary.{{key}}"
             value="{{lookup ../system.attributes.secondary key}}"
             {{#unless ../isEditable}}disabled{{/unless}} />
      <span class="t8-stat-dm">
        {{lookup ../system.attributes.secondary (concat key "DM")}}
      </span>
    </div>
    {{/each}}
  </div>
  {{/if}}
</div>