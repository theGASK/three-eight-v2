<div class="t8-tab-content">
  {{#if conditions.length}}
  <ul class="t8-condition-list">
    {{#each conditions as |cond|}}
    <li class="t8-condition-row {{#if cond.isActive}}active{{/if}}">
      <span class="t8-condition-name">{{cond.name}}</span>
      <span class="t8-condition-stacks">×{{cond.stacks}}</span>
      <button type="button" data-action="toggleCondition" data-condition-key="{{cond.key}}">
        <i class="fas {{#if cond.isActive}}fa-toggle-on{{else}}fa-toggle-off{{/if}}"></i>
      </button>
    </li>
    {{/each}}
  </ul>
  {{else}}
  <p class="t8-empty">{{localize "THREEEIGHT.Condition.None"}}</p>
  {{/if}}
</div>