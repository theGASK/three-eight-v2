<section class="t8-partA">
  <div class="t8-identity">
    <img class="t8-portrait"
         src="{{actor.img}}"
         data-edit="img"
         data-action="editImage"
         alt="{{actor.name}}" />
    <div class="t8-identity-text">
      <input class="t8-name" type="text" name="name" value="{{actor.name}}"
             {{#unless isEditable}}disabled{{/unless}} />
      <span class="t8-type-badge">{{typeLabel}}</span>
    </div>
  </div>

  <div class="t8-vitals">
    {{! Display-only — editing happens on the Characteristics tab. }}
    <div class="t8-vital">
      <span class="t8-vital-label">{{localize "THREEEIGHT.Actor.Wounds"}}</span>
      <div class="t8-vital-value">
        <span class="t8-vital-current">{{wounds}}</span>
        <span class="t8-vital-sep">/</span>
        <span class="t8-vital-max">{{woundsMax}}</span>
        <button type="button" class="t8-icon-btn"
                data-action="modifyWounds"
                title="{{localize 'THREEEIGHT.Wounds.DialogTitle'}}">
          <i class="fas fa-sliders"></i>
        </button>
      </div>
    </div>

    <div class="t8-vital">
      <span class="t8-vital-label">{{localize "THREEEIGHT.Actor.Effort"}}</span>
      <div class="t8-vital-value">
        <span class="t8-vital-current">{{effectiveEffort}}</span>
        <span class="t8-vital-sep">/</span>
        <span class="t8-vital-max">{{maxEffort}}</span>
        <button type="button" class="t8-icon-btn"
                data-action="modifyEffort"
                title="{{localize 'THREEEIGHT.Effort.DialogTitle'}}">
          <i class="fas fa-sliders"></i>
        </button>
      </div>
    </div>

    <div class="t8-vital t8-vital-compact">
      <span class="t8-vital-label">{{localize "THREEEIGHT.Actor.MeleeDefense"}}</span>
      <span class="t8-vital-static">{{meleeDefense}}</span>
    </div>

    <div class="t8-vital t8-vital-compact">
      <span class="t8-vital-label">{{localize "THREEEIGHT.Actor.RangedArmor"}}</span>
      <span class="t8-vital-static">{{rangedArmor}}</span>
    </div>

    <div class="t8-vital t8-vital-compact">
      <span class="t8-vital-label">{{localize "THREEEIGHT.Actor.MeleeArmor"}}</span>
      <span class="t8-vital-static">{{meleeArmor}}</span>
    
    </div>
        <div class="t8-vital t8-vital-compact t8-action-slots">
      <span class="t8-vital-label">{{localize "THREEEIGHT.Action.Slots"}}</span>
      
      <div class="t8-slot-badges">
        <span class="t8-slot-badge slow {{#if (gt economy.slowAvailable 0)}}available{{/if}}" title="{{localize 'THREEEIGHT.Action.Slow'}}">
          <i class="fas fa-hourglass-half"></i> {{economy.slowAvailable}}
        </span>
        <span class="t8-slot-badge fast {{#if (gt economy.fastAvailable 0)}}available{{/if}}" title="{{localize 'THREEEIGHT.Action.Fast'}}">
          <i class="fas fa-bolt"></i> {{economy.fastAvailable}}
        </span>
      </div>

      {{#if economy.isFresh}}
        <button type="button" class="t8-icon-btn t8-mode-toggle" data-action="toggleActionMode" 
                title="{{localize 'THREEEIGHT.Action.ToggleMode'}}">
          <i class="fas fa-exchange-alt"></i>
        </button>
      {{else}}
        <div class="t8-icon-btn t8-mode-toggle t8-disabled" title="{{localize 'THREEEIGHT.Action.ModeLocked'}}">
          <i class="fas fa-lock"></i>
        </div>
      {{/if}}
    </div>
  </div>
</section>